# LLM provider — Google AI Studio (https://aistudio.google.com), free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Search API for public interview-process discussion — https://tavily.com, free tier
TAVILY_API_KEY=

# MongoDB connection string — MongoDB Atlas free (M0) cluster, or a local mongod
MONGODB_URI=mongodb://127.0.0.1:27017/trao-interview-kit

# Signs session JWTs. Use a long random string in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express API listens on
PORT=4000

# Origin allowed to make credentialed requests — the deployed frontend URL
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development
